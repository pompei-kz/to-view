+/* Rust supplies the transparent label embedded in the executable. */
+extern SDL_Surface *to_view_load_menu_label(void);
+
+static void draw_menu(void)
+{
+    static SDL_Texture *label;
+    SDL_Rect dst = { 12, 12, 0, 0 };
+    int width;
+
+    if (!label) {
+        SDL_Surface *surface = to_view_load_menu_label();
+        if (!surface)
+            return;
+        label = SDL_CreateTextureFromSurface(renderer, surface);
+        SDL_FreeSurface(surface);
+        if (!label)
+            return;
+    }
+
+    if (SDL_GetRendererOutputSize(renderer, &width, NULL) < 0 || width <= 24 ||
+        SDL_QueryTexture(label, NULL, NULL, &dst.w, &dst.h) < 0)
+        return;
+    if (dst.w > width - 24) {
+        dst.h = FFMAX(1, dst.h * (width - 24) / dst.w);
+        dst.w = width - 24;
+    }
+    SDL_RenderCopy(renderer, label, NULL, &dst);
+}
