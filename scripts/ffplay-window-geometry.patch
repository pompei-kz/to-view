@@ -1326,0 +1327,15 @@
+extern void to_view_save_window_geometry(int x, int y, int width, int height);
+
+static SDL_Rect last_window_geometry;
+
+static void remember_window_geometry(void)
+{
+    Uint32 flags = SDL_GetWindowFlags(window);
+    if (!(flags & SDL_WINDOW_SHOWN) ||
+        flags & (SDL_WINDOW_FULLSCREEN | SDL_WINDOW_MAXIMIZED | SDL_WINDOW_MINIMIZED))
+        return;
+
+    SDL_GetWindowPosition(window, &last_window_geometry.x, &last_window_geometry.y);
+    SDL_GetWindowSize(window, &last_window_geometry.w, &last_window_geometry.h);
+}
+
@@ -1336 +1351,5 @@
-    if (window)
+    if (window) {
+        remember_window_geometry();
+        if (last_window_geometry.w > 0 && last_window_geometry.h > 0)
+            to_view_save_window_geometry(last_window_geometry.x, last_window_geometry.y,
+                                         last_window_geometry.w, last_window_geometry.h);
@@ -1337,0 +1357 @@
+    }
@@ -1386,0 +1407 @@
